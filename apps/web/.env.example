NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Affiliate tracking templates from approved programs. Ticket links are hidden until
# the matching provider template is configured. Templates must produce HTTPS URLs.
# Supported placeholders: {url}, {rawUrl}, {publisherId}, {subId}.
NEXT_PUBLIC_IMPACT_PUBLISHER_ID=
NEXT_PUBLIC_AFFILIATE_TEMPLATE_TICKETMASTER=
NEXT_PUBLIC_AFFILIATE_TEMPLATE_TICKETWEB=
NEXT_PUBLIC_AFFILIATE_TEMPLATE_SEATGEEK=
NEXT_PUBLIC_AFFILIATE_TEMPLATE_STUBHUB=
NEXT_PUBLIC_AFFILIATE_TEMPLATE_VIVIDSEATS=
NEXT_PUBLIC_AFFILIATE_TEMPLATE_AXS=
NEXT_PUBLIC_AFFILIATE_TEMPLATE_EVENTBRITE=

# ── Browser-safe keys (still needed by lib/data.ts for events + merch) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only keys for /api/poll (preferred — not exposed to the browser) ──
# Set SUPABASE_URL and SUPABASE_ANON_KEY without the NEXT_PUBLIC_ prefix.
# The poll API route will fall back to the NEXT_PUBLIC_ values above if these
# are not set, but migrating to server-only keys is strongly recommended.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Ticket Tailor global fallback checkout URL
# Per-event links can be stored in events.ticket_url
NEXT_PUBLIC_TICKETING_WIDGET_URL=
